# ==============================================================================
# RestaurantOS - Environment Variable Configuration Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO THIS FILE OR TO VERSION CONTROL
# Copy this file to '.env' and populate with actual credentials.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL / Supabase Database Connection
DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5432/restaurant_os_db
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase API Credentials
# Anon Key: Safe for browser frontend ONLY when Row Level Security (RLS) is enabled on all tables.
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Service Role Key: SERVER-SIDE ONLY. Bypasses RLS. NEVER expose to client code.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Stripe Payment Engine Integration
# Publishable Key: Safe for client-side frontend initialization
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Secret Key: SERVER-SIDE ONLY. NEVER expose to client.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# JWT Signing Secret (Server-side token validation)
JWT_SECRET=your_jwt_secret_signing_key_here

# Gemini AI Menu & Analytics Integration
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Google OAuth 2.0 Identity Services Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Frontend API Base URL
API_BASE_URL=https://restaurantos-3m17.onrender.com/api
